inspect_spatial <- function(x, name) {
  cat("\n----", name, "----\n")
  cat("Rows:", nrow(x), "\n")
  cat("CRS:", st_crs(x)$input, "\n")
  cat("Geometries:", paste(unique(as.character(st_geometry_type(x))), collapse = ", "), "\n")
  cat("Columns:\n")
  print(names(x))
}
inspect_spatial(iris, "IRIS boundaries")
inspect_spatial(green, "Green spaces")
inspect_spatial(trees, "Trees")
