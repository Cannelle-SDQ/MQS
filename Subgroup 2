  vapply(st_drop_geometry(green), function(z) is.character(z) || is.factor(z), logical(1))
]
cat("\nPossible green-space typology fields:\n")
for (nm in text_cols) {
  vals <- as.character(green[[nm]])
  matches <- grepl("Promenades ouvertes", vals, fixed = TRUE, ignore.case = TRUE)
  if (any(matches, na.rm = TRUE)) {
    cat("Field:", nm, "| matches:", sum(matches, na.rm = TRUE), "\n")
    print(head(sort(unique(vals[matches])), 10))
  }
}
cat("\nNext: confirm the matching typology field and edit GREEN_TYPE_COL in 01_build_subgroup2.R.\n")

