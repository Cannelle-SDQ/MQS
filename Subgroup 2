library(sf)
library(dplyr)
library(ggplot2)

input <- "data/processed/iris_subgroup2.geojson"
if (!file.exists(input)) stop("Run scripts/01_build_subgroup2.R first.")
x <- st_read(input, quiet = TRUE) %>% st_transform(2154)
dir.create("maps/subgroup2", recursive = TRUE, showWarnings = FALSE)

base_theme <- theme_void(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 15),
    plot.subtitle = element_text(size = 10),
    plot.caption = element_text(size = 8, color = "grey35"),
    legend.position = "right",
    plot.margin = margin(12, 12, 12, 12)
  )

save_map <- function(map, filename) {
  ggsave(file.path("maps/subgroup2", filename), plot = map,
         width = 10, height = 8, dpi = 300, bg = "white")
}

# ---- Map 1: income gradient by IRIS ----
x$income_group <- factor(x$income_quintile, levels = 1:5,
                         labels = paste0("Q", 1:5))
m_income <- ggplot(x) +
  geom_sf(aes(fill = income_group), color = "white", linewidth = 0.08) +
  scale_fill_brewer(palette = "Blues", drop = FALSE,
                    na.value = "grey85", name = "Income quintile") +
  labs(title = "Median disposable income across Paris",
       subtitle = "IRIS quintiles, from Q1 (lowest) to Q5 (highest), 2021",
       caption = "Source: INSEE Filosofi 2021; IRIS geographical boundaries") +
  coord_sf(datum = NA) + base_theme
save_map(m_income, "01_income_quintiles.png")

# ---- Map 2: open public parks/gardens as a share of IRIS area ----
m_green <- ggplot(x) +
  geom_sf(aes(fill = green_pct), color = "white", linewidth = 0.08) +
  scale_fill_viridis_c(option = "viridis", na.value = "grey85",
                       name = "Open parks and\ngardens (%)") +
  labs(title = "Open public green spaces across Paris",
       subtitle = "Share of IRIS area covered by selected 'Promenades ouvertes' polygons",
       caption = "Source: City of Paris Open Data, 'Espaces verts et assimilés' (download date to document)") +
  coord_sf(datum = NA) + base_theme
save_map(m_green, "02_public_green_share.png")

# ---- Map 3: income quintiles + tree density ----
# Point on surface remains inside each IRIS even for nonconvex shapes.
x_point <- st_point_on_surface(x)
m_trees <- ggplot() +
  geom_sf(data = x, aes(fill = income_group),
          color = "grey75", linewidth = 0.07) +
  geom_sf(data = x_point, aes(size = trees_per_ha),
          color = "#B64043", alpha = 0.6) +
  scale_fill_brewer(palette = "Blues", drop = FALSE,
                    na.value = "grey85", name = "Income quintile") +
  scale_size_area(max_size = 6, name = "Recorded municipal\ntrees per hectare") +
  labs(title = "Income and recorded municipal tree density",
       subtitle = "Tree locations aggregated to IRIS; circle area represents trees/ha",
       caption = "Sources: INSEE Filosofi 2021 and City of Paris tree inventory (inventory date to document)") +
  coord_sf(datum = NA) + base_theme
save_map(m_trees, "03_trees_and_income.png")

print(m_income)
print(m_green)
print(m_trees)
message("Maps saved in maps/subgroup2/.")

