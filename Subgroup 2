library(sf)
library(dplyr)
library(readr)

# ---- A. Configuration. Verify using 00_check_data.R ----
IRIS_ID_COL <- "CODE_IRIS"
INCOME_ID_COL <- "IRIS"
INCOME_VALUE_COL <- "DISP_MED21"
FILOSOFI_DELIM <- ";"

# Explicitly set the name of the field for "Typologie d'espace vert"
# after inspecting `names(green)` in 00_check_data.R.
# For safety, a missing or incorrect field causes an informative error.
GREEN_TYPE_COL <- NA_character_  # Auto-detect if exactly one field has the official category
GREEN_KEEP_VALUES <- c("Promenades ouvertes")

paths <- c(
  iris = "data/raw/iris_paris.geojson",
  income = "data/raw/filosofi_2021.csv",
  green = "data/raw/espaces_verts.geojson",
  trees = "data/raw/arbres.geojson"
)
if (!all(file.exists(paths))) stop("Missing data/raw/ files. Run 00_check_data.R first.")
dir.create("data/processed", recursive = TRUE, showWarnings = FALSE)

assert_field <- function(data, field, dataset) {
  if (!field %in% names(data)) {
    stop(dataset, ": expected column '", field, "' not found. Available columns: ",
         paste(names(data), collapse = ", "))
  }
}
assert_crs <- function(x, dataset) {
  if (is.na(st_crs(x))) stop(dataset, " has no CRS: assign the correct source CRS before transforming.")
}

# ---- B. Read sources and check inputs ----
iris_raw <- st_read(paths["iris"], quiet = TRUE)
filo_raw <- read_delim(paths["income"], delim = FILOSOFI_DELIM,
                       col_types = cols(.default = col_character()),
                       show_col_types = FALSE)
green_raw <- st_read(paths["green"], quiet = TRUE)
trees_raw <- st_read(paths["trees"], quiet = TRUE)

assert_field(iris_raw, IRIS_ID_COL, "IRIS")
assert_field(filo_raw, INCOME_ID_COL, "Filosofi")
assert_field(filo_raw, INCOME_VALUE_COL, "Filosofi")
for (nm in c("IRIS", "Green spaces", "Trees")) {
  obj <- switch(nm, "IRIS" = iris_raw, "Green spaces" = green_raw, "Trees" = trees_raw)
  assert_crs(obj, nm)
}

# ---- C. Clean Paris IRIS boundaries (metric CRS) ----
iris <- iris_raw %>%
  mutate(CODE_IRIS = trimws(as.character(.data[[IRIS_ID_COL]]))) %>%
  filter(grepl("^75[0-9]{7}$", CODE_IRIS)) %>%
  st_transform(2154) %>%
  st_make_valid()

if (nrow(iris) == 0) stop("No Paris IRIS found: inspect codes and input geography.")
if (anyDuplicated(iris$CODE_IRIS)) stop("Duplicated IRIS polygon IDs.")
if (!all(as.character(st_geometry_type(iris)) %in% c("POLYGON", "MULTIPOLYGON"))) {
  stop("IRIS geometry must consist of polygons only.")
}
if (any(st_is_empty(iris))) stop("Empty IRIS geometries detected.")

# ---- D. Join 2021 disposable median incomes ----
# Allow French thousands spaces, nonbreaking spaces, and decimal commas.
parse_french_number <- function(z) {
  z <- gsub("[\u00a0\u202f[:space:]]", "", as.character(z), perl = TRUE)
  suppressWarnings(parse_number(z, locale = locale(decimal_mark = ",", grouping_mark = ".")))
}
income <- filo_raw %>%
  transmute(
    CODE_IRIS = trimws(as.character(.data[[INCOME_ID_COL]])),
    income_med_2021 = parse_french_number(.data[[INCOME_VALUE_COL]])
  ) %>%
  filter(CODE_IRIS %in% iris$CODE_IRIS)

if (anyDuplicated(income$CODE_IRIS)) stop("Duplicated Filosofi IRIS codes: identify the correct table.")
missing_income_ids <- setdiff(iris$CODE_IRIS, income$CODE_IRIS)
if (length(missing_income_ids) > 0) {
  warning(length(missing_income_ids), " IRIS geometries have no matching Filosofi row.")
}

iris <- iris %>%
  left_join(income, by = "CODE_IRIS", relationship = "one-to-one") %>%
  mutate(area_m2 = as.numeric(st_area(geometry)),
         area_ha = area_m2 / 10000)
if (any(iris$area_m2 <= 0 | !is.finite(iris$area_m2))) {
  stop("IRIS area must be positive and finite.")
}

# ---- E. Parks and public gardens: explicitly selected category ----
green <- green_raw %>% st_transform(2154) %>% st_make_valid()
if (is.na(GREEN_TYPE_COL)) {
  candidate_fields <- names(st_drop_geometry(green))[
    vapply(st_drop_geometry(green), function(col) {
      vals <- tolower(trimws(as.character(col)))
      any(vals %in% tolower(GREEN_KEEP_VALUES), na.rm = TRUE)
    }, logical(1))
  ]
  if (length(candidate_fields) != 1L) {
    stop("Cannot identify ONE green-space type field; candidates are: ",
         paste(candidate_fields, collapse = ", "),
         ". Inspect 00_check_data.R and set GREEN_TYPE_COL explicitly.")
  }
  GREEN_TYPE_COL <- candidate_fields[[1]]
}
assert_field(green, GREEN_TYPE_COL, "Green spaces")
message("Green-space category field: ", GREEN_TYPE_COL)
if (!all(as.character(st_geometry_type(green)) %in% c("POLYGON", "MULTIPOLYGON"))) {
  stop("Green-space geometry must be polygonal. Check the download format.")
}
actual_category <- trimws(as.character(green[[GREEN_TYPE_COL]]))
keep <- !is.na(actual_category) & tolower(actual_category) %in% tolower(GREEN_KEEP_VALUES)
green_open <- green[keep, , drop = FALSE]
if (nrow(green_open) == 0) {
  stop("No green polygons matched. Check GREEN_TYPE_COL and GREEN_KEEP_VALUES.")
}
message("Selected ", nrow(green_open), " public-green-space polygons from category: ",
        paste(GREEN_KEEP_VALUES, collapse = ", "))

# Dissolve overlaps first, intersect with each IRIS, and measure clipped polygons.
green_union <- st_sf(geometry = st_union(st_geometry(green_open)))
green_parts <- suppressWarnings(st_intersection(
  iris %>% select(CODE_IRIS), green_union
))
green_by_iris <- green_parts %>%
  mutate(green_m2 = as.numeric(st_area(geometry))) %>%
  st_drop_geometry() %>%
  group_by(CODE_IRIS) %>%
  summarise(green_m2 = sum(green_m2), .groups = "drop")

# ---- F. Tree points: one point assigned to at most one IRIS ----
trees <- trees_raw %>% st_transform(2154)
if (!all(as.character(st_geometry_type(trees)) == "POINT")) {
  stop("Trees layer must contain POINT features. Inspect its geometry or convert carefully.")
}
# st_within gives an empty match for an outside/boundary point, counted in QA.
within_iris <- st_within(trees, iris)
matched <- lengths(within_iris) == 1L
ambiguous <- lengths(within_iris) > 1L
if (any(ambiguous)) stop("Some tree points match more than one IRIS: inspect polygon overlaps.")
assigned_ids <- iris$CODE_IRIS[vapply(within_iris[matched], `[`, integer(1), 1L)]
trees_by_iris <- tibble(CODE_IRIS = assigned_ids) %>%
  count(CODE_IRIS, name = "n_trees")

# ---- G. Calculate indicators and checks ----
iris_result <- iris %>%
  left_join(green_by_iris, by = "CODE_IRIS", relationship = "one-to-one") %>%
  left_join(trees_by_iris, by = "CODE_IRIS", relationship = "one-to-one") %>%
  mutate(
    green_m2 = coalesce(green_m2, 0),
    n_trees = coalesce(n_trees, 0L),
    green_pct = 100 * green_m2 / area_m2,
    green_m2_per_ha = green_m2 / area_ha,
    trees_per_ha = n_trees / area_ha,
    income_quintile = ntile(income_med_2021, 5)
  )

if (nrow(iris_result) != nrow(iris)) stop("Spatial joins duplicated or dropped IRIS rows.")
if (any(iris_result$green_pct < -1e-6 | iris_result$green_pct > 100 + 1e-6)) {
  stop("Green area share outside 0–100%; investigate intersections and CRS.")
}
if (any(iris_result$n_trees < 0)) stop("Invalid negative tree counts.")

quality_checks <- tibble(
  indicator = c("n_IRIS", "n_IRIS_missing_income", "n_IRIS_no_filosofi_row",
                "n_selected_green_polygons", "n_trees_source", "n_trees_assigned",
                "n_trees_unassigned", "mean_green_pct", "mean_trees_per_ha"),
  value = c(nrow(iris_result), sum(is.na(iris_result$income_med_2021)),
            length(missing_income_ids), nrow(green_open), nrow(trees),
            sum(matched), sum(!matched),
            mean(iris_result$green_pct), mean(iris_result$trees_per_ha))
)
print(quality_checks)

quintile_summary <- iris_result %>%
  st_drop_geometry() %>%
  filter(!is.na(income_quintile)) %>%
  group_by(income_quintile) %>%
  summarise(n_iris = n(),
            median_income = median(income_med_2021, na.rm = TRUE),
            median_green_pct = median(green_pct, na.rm = TRUE),
            median_trees_per_ha = median(trees_per_ha, na.rm = TRUE),
            .groups = "drop")
print(quintile_summary)

# ---- H. Save processed data and diagnostic tables ----
st_write(st_transform(iris_result, 4326), "data/processed/iris_subgroup2.geojson",
         delete_dsn = TRUE, quiet = TRUE)
write_csv(st_drop_geometry(iris_result), "data/processed/iris_subgroup2.csv")
write_csv(quality_checks, "data/processed/quality_checks_subgroup2.csv")
write_csv(quintile_summary, "data/processed/income_quintile_summary.csv")
message("Created IRIS-level files in data/processed/.")

--
# Relationship between income and green spaces
cor.test(
  iris_result$income_med_2021,
  iris_result$green_pct,
  method = "spearman",
  use = "complete.obs",
  exact = FALSE
)

# Relationship between income and tree density
cor.test(
  iris_result$income_med_2021,
  iris_result$trees_per_ha,
  method = "spearman",
  use = "complete.obs",
  exact = FALSE
)

